DATABASE_URL=sqlite:///./traceback.db
# PostgreSQL / Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set a random secret of at least 32 characters for persistent sessions.
JWT_SECRET=
AI_MODE=demo
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional OpenAI Responses-compatible endpoint:
# AI_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: ENVIRONMENT=production refuses weak or missing JWT_SECRET.
ENVIRONMENT=development
# Serve built React UI and API from the same origin (requires npm run build):
SERVE_FRONTEND=false
# Authentication requests per IP per minute, single process:
AUTH_RATE_LIMIT=30
# Docker Compose / hosted Supabase database (keep DATABASE_URL for local dev):
# DEPLOY_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
